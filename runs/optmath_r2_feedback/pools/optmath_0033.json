,(4,3):193,(4,5):157,(4,6):137,\n        (5,0):134,(5,1):128,(5,2):241,(5,3):143,(5,4):198,(5,6):213,\n        (6,0):213,(6,1):206,(6,2):184,(6,3):231,(6,4):207,(6,5):165,\n    },\n}\n\n\ndef build_model(data=None):\n    d = data or DATA\n    model = pyo.ConcreteModel()\n\n    model.N = pyo.Set(initialize=d[\"nodes\"], ordered=True)\n    model.A = pyo.Set(initialize=d[\"arcs\"], dimen=2)\n\n    # y[i,j] = 1 if connection established\n    model.y = pyo.Var(model.A, within=pyo.Binary)\n    # x[i,j] = units transported on arc (i,j); bounded by arc capacity\n    model.x = pyo.Var(\n        model.A,\n        within=pyo.NonNegativeReals,\n        bounds=lambda m, i, j: (0, d[\"capacity\"][i, j]),\n    )\n\n    def obj_rule(m):\n        fixed = sum(d[\"fixed_cost\"][i, j] * m.y[i, j] for (i, j) in m.A)\n        var = sum(d[\"var_cost\"][i, j] * m.x[i, j] for (i, j) in m.A)\n        return fixed + var\n    model.obj = pyo.Objective(rule=obj_rule, sense=pyo.minimize)\n\n    # Linking: flow on arc <= capacity * build-decision (linear in y, constant coeff)\n    def cap_rule(m, i, j):\n        return m.x[i, j] <= d[\"capacity\"][i, j] * m.y[i, j]\n    model.cap = pyo.Constraint(model.A, rule=cap_rule)\n\n    # Flow balance: incoming - outgoing = net_demand (linear)\n    def bal_rule(m, n):\n        inflow = sum(m.x[i, j] for (i, j) in m.A if j == n)\n        outflow = sum(m.x[i, j] for (i, j) in m.A if i == n)\n        return inflow - outflow == d[\"net_demand\"][n]\n    model.balance = pyo.Constraint(model.N, rule=bal_rule)\n\n    return model\n\n\nGOLD_ANSWER = None\n",
