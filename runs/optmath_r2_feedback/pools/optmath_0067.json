ary domains)\n    model.build = pyo.Var(model.TOWERS, within=pyo.Binary)\n    model.cover = pyo.Var(model.AREAS, within=pyo.Binary)\n\n    # Objective: maximize total population covered\n    def obj_rule(m):\n        return sum(pop[j] * m.cover[j] for j in m.AREAS)\n\n    model.obj = pyo.Objective(rule=obj_rule, sense=pyo.maximize)\n\n    # Budget constraint: total construction cost must not exceed budget\n    def budget_rule(m):\n        return sum(cost[t] * m.build[t] for t in m.TOWERS) <= budget\n\n    model.budget_con = pyo.Constraint(rule=budget_rule)\n\n    # Coverage linking: area j can be covered only if at least one serving\n    # tower is built.  This is linear: cover[j] <= sum(build[t] for t in S_j)\n    def cover_link_rule(m, j):\n        return m.cover[j] <= sum(m.build[t] for t in towers_for_area[j])\n\n    model.cover_link = pyo.Constraint(model.AREAS, rule=cover_link_rule)\n\n    return model\n",
