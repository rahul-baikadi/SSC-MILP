R = None\n\n\ndef build_model(data=None):\n    d = data or DATA\n\n    model = pyo.ConcreteModel()\n\n    # Sets\n    model.TOWERS = pyo.Set(initialize=sorted(d[\"cost\"].keys()))\n    model.REGIONS = pyo.Set(initialize=sorted(d[\"population\"].keys()))\n\n    # Decision: build tower i or not (binary)\n    # \"For each of the 29 potential tower locations, you must decide whether to build the tower (a binary decision: build or not build).\"\n    model.y = pyo.Var(model.TOWERS, within=pyo.Binary)\n\n    # Decision: region j covered or not (binary)\n    # \"For each of the 35 regions, you must determine whether it will be covered by at least one of the built towers (a binary decision: covered or not covered).\"\n    model.z = pyo.Var(model.REGIONS, within=pyo.Binary)\n\n    # Objective: maximize total population covered\n    # \"Maximize the total population covered by the deployed cell towers.\"\n    def obj_rule(m):\n        return sum(d[\"population\"][j] * m.z[j] for j in m.REGIONS)\n\n    model.obj = pyo.Objective(rule=obj_rule, sense=pyo.maximize)\n\n    # Budget constraint: total cost <= budget\n    # \"The total cost of building the selected towers must not exceed the available budget of 2,968 units.\"\n    def budget_rule(m):\n        return sum(d[\"cost\"][i] * m.y[i] for i in m.TOWERS) <= d[\"budget\"]\n\n    model.budget = pyo.Constraint(rule=budget_rule)\n\n    # Coverage linking: z[j] >= sum_{i serves j} y[i]\n    # \"For a region to be considered covered, at least one of the towers that can serve it must be built.\"\n    # assumption: coverage_linking_direction z[j] >= sum_{i serves j} y[i]\n    def cover_rule(m, j):\n        return m.z[j] >= sum(m.y[i] for i in d[\"serves\"][j])\n\n    model.cover = pyo.Constraint(model.REGIONS, rule=cover_rule)\n\n    return model\n",
